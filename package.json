{
	"name": "floorplan2d",
	"private": false,
	"version": "0.9.3",
	"description": "Reusable 2D floor plan editor for React applications",
	"author": "theLodgeStudio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/theLodgeBots/open3dFloorplan.git"
	},
	"type": "module",
	"files": [
		"dist",
		"README.md",
		"REACT_USAGE.zh-CN.md",
		"LICENSE"
	],
	"module": "./dist/floorplan2d.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/floorplan2d.es.js"
		},
		"./styles.css": "./dist/floorplan2d.css"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"package": "vite build --config vite.config.lib.ts",
		"package:check": "npm run package && npm pack --dry-run"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.3",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/cli": "^4.1.18",
		"@tailwindcss/vite": "^4.1.18",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"dxf-writer": "^1.18.4",
		"firebase": "^12.9.0",
		"jspdf": "^4.1.0",
		"jszip": "^3.10.1"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0",
		"svelte": "^5.0.0"
	}
}
